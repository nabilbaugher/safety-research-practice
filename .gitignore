# Public participant repository: ignore everything unless explicitly allowed.
# Add intentional new participant files here before committing them.
# Organizer notes, old pilots, release ZIPs, credentials, runs, models,
# environments, caches and other generated files remain ignored.
/*
!/.gitignore
!/README.md
!/two-hour/
/two-hour/**

# Allow traversal only through directories used by the participant package.
!/two-hour/cache/
!/two-hour/configs/
!/two-hour/slides_template/
!/two-hour/vendor/
!/two-hour/slides_template/figures/
!/two-hour/vendor/nocot_bench/
!/two-hour/vendor/nocot_bench/datagen/
!/two-hour/vendor/nocot_bench/datagen/banks/

# Explicit participant-file allowlist.
!/two-hour/AI_LOGGING.md
!/two-hour/AI_LOGS.md
!/two-hour/MANIFEST.json
!/two-hour/PILOT_FEEDBACK.md
!/two-hour/PREDICTIONS.md
!/two-hour/README.md
!/two-hour/SETUP.md
!/two-hour/SOURCES.md
!/two-hour/cache/README.md
!/two-hour/cache/baseline.jsonl
!/two-hour/cache/baseline.jsonl.meta.json
!/two-hour/cache/baseline.jsonl.source.py
!/two-hour/configs/baseline.json
!/two-hour/configs/smoke.json
!/two-hour/requirements.txt
!/two-hour/slides_template/README.md
!/two-hour/slides_template/REMARK_LICENSE.txt
!/two-hour/slides_template/build.py
!/two-hour/slides_template/figures/README.md
!/two-hour/slides_template/slides.html
!/two-hour/slides_template/slides.md
!/two-hour/starter.py
!/two-hour/test_starter.py
!/two-hour/vendor/nocot_bench/LICENSE
!/two-hour/vendor/nocot_bench/UPSTREAM.json
!/two-hour/vendor/nocot_bench/datagen/__init__.py
!/two-hour/vendor/nocot_bench/datagen/banks/__init__.py
!/two-hour/vendor/nocot_bench/datagen/banks/brew.py
!/two-hour/vendor/nocot_bench/datagen/common.py
